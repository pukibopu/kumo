{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
        },
        {
            "name": "macos-debug",
            "inherits": "base",
            "generator": "Ninja",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "macos-release",
            "inherits": "base",
            "generator": "Ninja",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "ios-arm64-compile",
            "inherits": "base",
            "generator": "Ninja",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_SYSROOT": "iphoneos",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "17.0",
                "KUMO_BUILD_DESKTOP_APPS": "OFF",
                "KUMO_BUILD_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "macos-debug", "configurePreset": "macos-debug" },
        { "name": "macos-release", "configurePreset": "macos-release" },
        { "name": "ios-arm64-compile", "configurePreset": "ios-arm64-compile" }
    ],
    "testPresets": [
        { "name": "macos-debug", "configurePreset": "macos-debug", "output": { "outputOnFailure": true } },
        { "name": "macos-release", "configurePreset": "macos-release", "output": { "outputOnFailure": true } }
    ]
}
