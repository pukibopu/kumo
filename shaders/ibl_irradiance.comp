#version 460
#extension GL_GOOGLE_include_directive : require

#include "cubemap.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform textureCube environmentMap;
layout(set = 0, binding = 1) uniform sampler environmentSampler;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D dstFace;

layout(push_constant) uniform Params {
    int face;
}
params;

const float PI = 3.14159265359;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dstFace);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec3 N = cubeFaceDirection(params.face, uv);

    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = cross(N, right);

    // Discrete hemisphere integration; a mid-chain mip keeps fireflies down.
    const float sampleDelta = 0.025;
    vec3 irradiance = vec3(0.0);
    float sampleCount = 0.0;
    for (float phi = 0.0; phi < 2.0 * PI; phi += sampleDelta) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += sampleDelta) {
            vec3 tangentDir =
                vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            vec3 dir = tangentDir.x * right + tangentDir.y * up + tangentDir.z * N;
            irradiance += textureLod(samplerCube(environmentMap, environmentSampler), dir, 2.0).rgb *
                          cos(theta) * sin(theta);
            sampleCount += 1.0;
        }
    }
    irradiance = PI * irradiance / sampleCount;
    imageStore(dstFace, coord, vec4(irradiance, 1.0));
}
